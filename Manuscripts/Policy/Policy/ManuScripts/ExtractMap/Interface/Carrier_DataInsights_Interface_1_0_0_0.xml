      <private id="Insights.SendQuote" caption="" type="string" path="SendByMS" comment="SendQuote is called in AllStatusChangeActions.Value in WorkFlow manuscript even when a &#xD;&#xA;policy is committed, so i want to ignore in this case. Because i want this call to happen during&#xD;&#xA;the integrationcommitevent otherwise i get multiple calls." override="1">
        <value>
          <if>
            <condition>
              <comparison compare="and">
                <comparison compare="eq">
                  <operand idref="Insights.CheckIfSendQuote" type="string" />
                  <operand type="int" value="1" />
                </comparison>
                <comparison compare="eq">
                  <operand idref="Insights.ClarityEnable" type="boolean" />
                  <operand type="int" value="1" />
