          <private id="TaskRecordPrivate.Level4AHTaskQueues" caption="" type="string">
            <value>
              <calculation>
                <argument op="eq" type="string" value="QueueList/Queue[Name='AH WA Queue'  or " />
                <argument op="add" type="string" value="Name='AH NSW Queue' or " />
                <argument op="add" type="string" value="Name='AH NZ Queue' or " />
                <argument op="add" type="string" value="Name='AH QLD Queue' or " />
                <argument op="add" type="string" value="Name='AH SA/NT Queue' or " />
                <argument op="add" type="string" value="Name='AH VIC/North Queue' or " />
                <argument op="add" type="string" value="Name='AH RSO Queue' or " />
                <argument op="add" type="string" value="Name='AH RSE Queue' or " />
                <argument op="add" type="string" value="Name='AH RAM Direct Queue' or " />
                <argument op="add" type="string" value="Name='RSO Queue']" />
              </calculation>
            </value>
