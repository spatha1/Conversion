          <private id="TaskRecordPrivate.TaskQueues" caption="" type="string">
            <misc>
              <if>
                <condition idref="Context.IsUnderwriters" />
                <then idref="TaskRecordPrivate.UWTaskQueues" />
              </if>
              <if>
                <condition idref="Context.IsCurrentContextLevel0AH" />
                <then value="QueueList/Queue[Name='AH RSO Queue' or Name='RSO Queue']" />
              </if>
              <if>
                <condition idref="Context.IsCurrentContextLevelRSE" />
                <then value="QueueList/Queue[Name='AH RSE Queue' ]" />
              </if>
              <if>
                <condition>
                  <comparison compare="or">
                    <comparison compare="or">
                      <operand idref="Context.IsCurrentContextLevel2AH" type="boolean" />
                      <operand idref="Context.IsCurrentContextLevel3AH" type="boolean" />
                    </comparison>
                    <operand idref="Context.IsCurrentUserRAM" type="boolean" />
                  </comparison>
                </condition>
                <then idref="TaskRecordPrivate.Level2AH3AH1AHTaskQueues" />
              </if>
              <if>
                <condition idref="Context.IsCurrentContextLevel4AH" />
                <then idref="TaskRecordPrivate.Level4AHTaskQueues" />
              </if>
              <if>
                <condition idref="Context.IsCurrentUserRAM" type="boolean" />
                <then value="QueueList/Queue[Name='AH RAM Direct Queue']" />
              </if>
            </misc>
            <value value="" />
          </private>
          <private id="TaskRecordPrivate.UWTaskQueues" caption="" type="string">
            <value>
              <calculation>
                <argument op="eq" type="string" value="QueueList/Queue[Name='UW WA Queue'  or " />
                <argument op="add" type="string" value="Name='UW NSW Queue' or " />
                <argument op="add" type="string" value="Name='UW NZ Queue' or " />
                <argument op="add" type="string" value="Name='UW QLD Queue' or " />
                <argument op="add" type="string" value="Name='UW SA/NT Queue' or " />
                <argument op="add" type="string" value="Name='UW VIC/North Queue' or " />
                <argument op="add" type="string" value="Name='UW VIC TAS Queue']" />
              </calculation>
            </value>
          </private>
          <private id="TaskRecordPrivate.Level2AH3AH1AHTaskQueues" caption="" type="string">
            <value>
              <calculation>
                <argument op="eq" type="string" value="QueueList/Queue[Name='AH WA Queue'  or " />
