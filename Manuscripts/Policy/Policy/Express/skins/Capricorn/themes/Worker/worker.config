<?xml version="1.0" encoding="UTF-8" ?>
<themeSettings theme="Worker">
	<Controls>
		<ComboBoxPaddingString enabled="1">Wo</ComboBoxPaddingString>
		<HelpIcons enabled="0"/>
		<UseMoreDropDownForTopNav enabled="1"/>
		<HoverPolicyActions enabled="1"/>
		<PartyToolsInsideFields enabled="1"/>
		<DisableDashboardPortals enabled="1"/>
		<MaxClientNameLength enabled="1">25</MaxClientNameLength>
	</Controls>
	<Navigation>
		<GroupSpecialActionsWithMainActions enabled="1"/>
		<ResponsiveLeftNav enabled="0" />
	</Navigation>
	<HideErrorStack enabled="1">
		<role>Consumer</role>
	</HideErrorStack>
	<ErrorEmails enabled="1">
		<from>do-not-reply@test.com</from>
		<!-- Use keywords {machine} and {when} in subject as needed -->
		<subject>Express Error Report: {machine} at {when}</subject>
	</ErrorEmails>
	<LayoutAbstraction enabled="1">
		<family>DCTTemplates</family>
	</LayoutAbstraction>
	<custom></custom>
</themeSettings>