          </if>
        </value>
      </private>
      <private id="Insights.ClarityEnable" caption="" type="boolean">
        <value>
          <request verb="Settings.getPropertyRq" get="@value">
            <responsePath value="" />
            <onFailure value="" />
            <modifySession value="" />
            <usesSession value="" />
            <default value="" />
            <nameValues>
              <nameValue value="CustomVariables.ClarityEnabled" name="name" dataType="attribute" />
            </nameValues>
          </request>
        </value>
      </private>
      <private id="Insights.ClarityEnableCondition" caption="" type="boolean">
        <value>
