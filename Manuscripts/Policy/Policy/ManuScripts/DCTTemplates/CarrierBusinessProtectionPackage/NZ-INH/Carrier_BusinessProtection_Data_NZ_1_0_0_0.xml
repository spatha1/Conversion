            <object id="PropertyMessages" abstract="1">
              <object id="PropertyMessage" abstract="1">
                <object id="PropertyMessagePrivate" abstract="1">
                  <private id="PropertyMessagePrivate.PPUW02_01UWRulesCondition" caption="" type="boolean" comment="ATP-9476: Updated hardcoded limits with lookup fields&#xD;&#xA;ATP-10071: Removed country check as its applicable for both AU/NZ&#xD;&#xA;ATP-9994: even when the SQM Aon is 0 rule need to be triggered" override="1">
                    <value>
                      <comparison compare="and">
                        <comparison compare="and">
                          <comparison compare="and">
                            <comparison compare="eq">
                              <operand idref="ConstructionOfBuildingInput.RoofConstruction" type="string" />
                              <operand type="string" value="Asbestos" />
                            </comparison>
                            <comparison compare="ge">
                              <operand idref="GeneralRiskAssessmentInput.RoofSqmAon" type="float" />
                              <operand idref="PropertyMessagePrivate.MinimumLimit" type="int" />
                            </comparison>
                          </comparison>
                          <comparison compare="le">
                            <operand idref="GeneralRiskAssessmentInput.RoofSqmAon" type="float" />
                            <operand idref="PropertyMessagePrivate.MaximumLimit" type="float" />
                          </comparison>
                        </comparison>
                        <comparison compare="eq">
                          <operand idref="PropertyMessageInput.RuleID" type="string" />
                          <operand type="string" value="PPUW02_01" />
                        </comparison>
                      </comparison>
                    </value>
                  </private>
                  <private id="PropertyMessagePrivate.MinimumLimit" caption="" type="int" comment="ATP-9476: To get dynamic values from table&#xD;&#xA;ATP-9994- added ignoreup after renew is performed for MTA have to pick renew limits" override="1">
                    <value>
                      <if>
                        <condition>
                          <comparison compare="and">
                            <comparison compare="and">
                              <operand idref="PolicyPrivate.IsCurrentTransactionEndorse" type="boolean" />
                              <comparison compare="gt">
                                <operand idref="CurrentTransaction.RenewCount" type="int" />
                                <operand type="int" value="0" />
                              </comparison>
                            </comparison>
                            <comparison compare="is">
                              <operand idref="PropertyMessageInput.RuleID" type="string" />
                              <operand type="string" value="PPUW02_01,PPUW02_02,PPUW02_03" />
                            </comparison>
                          </comparison>
                        </condition>
                        <then idref="PropertyMessagePrivate.MinimumLimitPPUW02" />
                        <else>
                          <lookup>
                            <tableRef value="UWRulesMinMaxLimits" />
                            <fieldRef value="MinLimt" />
                            <keyRef idref="PropertyMessageInput.RuleID" type="string" name="RuleID" />
                            <keyRef idref="PolicyPrivate.UWRulesTransactionType" type="string" name="TransactionType" />
                          </lookup>
                        </else>
                      </if>
                    </value>
                  </private>
                  <private id="PropertyMessagePrivate.MaximumLimit" caption="" type="float" override="1" comment="ATP-9994- added ignoreup after renew is performed for MTA have to pick renew limits">
                    <value>
                      <if>
                        <condition>
                          <comparison compare="and">
                            <comparison compare="and">
                              <operand idref="PolicyPrivate.IsCurrentTransactionEndorse" type="boolean" />
                              <comparison compare="gt">
                                <operand idref="CurrentTransaction.RenewCount" type="int" />
                                <operand type="int" value="0" />
                              </comparison>
                            </comparison>
                            <comparison compare="is">
                              <operand idref="PropertyMessageInput.RuleID" type="string" />
                              <operand type="string" value="PPUW02_01,PPUW02_02,PPUW02_03" />
                            </comparison>
                          </comparison>
                        </condition>
                        <then idref="PropertyMessagePrivate.MaximumLimitPPUW02" />
                        <else>
                          <lookup>
                            <tableRef value="UWRulesMinMaxLimits" />
                            <fieldRef value="MaxLimit" />
                            <keyRef idref="PropertyMessageInput.RuleID" type="string" name="RuleID" />
                            <keyRef idref="PolicyPrivate.UWRulesTransactionType" type="string" name="TransactionType" />
                          </lookup>
                        </else>
                      </if>
                    </value>
                  </private>
                </object>
