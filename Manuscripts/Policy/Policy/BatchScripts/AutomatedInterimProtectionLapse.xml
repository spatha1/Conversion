<server>
  <requests>
    <Session.loginRq userName="#{dctServerUserName}" password="#{dctServerPassword}"/>
    <Request.setVarRq name="WorkflowManuscriptID" value="Carrier_Package_Workflow_1_0_0_0" type="var" />
    <BatchProcess.processRq expandChildTokens="2">
      <Info>
        <ScriptName name="AutomatedInterimProtectionLapse" id="AutomatedInterimProtectionLapse" />
        <Output logType="Errors Only" append="" />
        <Email use="" from="" to="" />
      </Info>
      <Query>
        <requests>
		  <Catalog.getXMLImageRq resourceID="IntegrationConfig" catalogID="IntegrationConfigCatalog" var.Days="//BatchProcessItems/BatchProcessItem[@ScriptId='LapseofInterimProtection']/@days"/>
          <DateTime.todayRq format="yyyy-MM-dd" var.today="@value" />
          <DateTime.addRq date="~today~" days="~Days~" format="yyyy-MM-dd" var.today2="@value" />
          <OnlineData.listRq startIndex="1" maxItems="100000" listAll="1" noLock="1">
            <keys>
              <key name="Description2" op="contains" value="InterimProtectionApprove" />
              <key name="Extended.LastStatusChange" value="~today2~" op="equal" />
              <key name="LOB" value="CarrierBusinessPackage" op="equal" />
            </keys>
          </OnlineData.listRq>
        </requests>
      </Query>
      <PreExecute>
        <requests />
      </PreExecute>
      <Execute each="OnlineData.listRs/policyList/policy">
        <requests var.policyID="@policyID">
          <CustomServer.processRq>
            <dataRequests />
            <xsltRequests xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
              <OnlineData.loadPolicyRq policyID="~policyID~" var.loadPolicyRqstatus="@status" var.LoadErrorResponse="errors/error[last()]" />
              <Request.ifRq condition="'~loadPolicyRqstatus~' != 'success'">
                <then>
                  <xsl:element name="OnlineData.addLogRq">
                    <xsl:attribute name="logType">
                      <xsl:text>PolicyRemainder:Load Policy Failure</xsl:text>
                    </xsl:attribute>
                    <xsl:attribute name="action">
                      <xsl:text>~policyID~:Error</xsl:text>
                    </xsl:attribute>
                    <xsl:element name="params">
                      <xsl:element name="param">
                        <xsl:attribute name="name">
                          <xsl:text>policyID</xsl:text>
                        </xsl:attribute>
                        <xsl:attribute name="value">~policyID~</xsl:attribute>
                      </xsl:element>
                      <xsl:element name="param">
                        <xsl:attribute name="name">
                          <xsl:text>ErrorIn</xsl:text>
                        </xsl:attribute>
                        <xsl:attribute name="value">~LoadErrorResponse~</xsl:attribute>
                      </xsl:element>
                    </xsl:element>
                  </xsl:element>
                </then>
                <else>
                  <CustomServer.processRq var.RenewStatus="//ManuScript.getValueRs/@status" var.IntegrationErrorResponse="errors/error[last()]" >
                    <dataRequests />
                    <xsltRequests xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
                      <Session.setElementRq path="_processingData^PolicyWorkflowData/DeclinationReason" value="System lapse" />
                      <ManuScript.getValueRq manuscript="~WorkflowManuscriptID~" field="Decline.Action" />
					  <Session.setElementRq path="_processingData^PolicyWorkflowData/SelectTemplate" value="InterimProtectionLapse"/>
					  <Session.setElementRq path="_Communications^messagesandemail/emails/Subject" value="NOTIFICATION - EXPIRED COMMERCIAL PROTECTION"/>
					  <ManuScript.getValueRq manuscript="~WorkflowManuscriptID~" field="PolicyWorkflowDataPrivate.SetEmailIntegrationParameters"/>
					  <ManuScript.getValueRq manuscript="~WorkflowManuscriptID~" field="PolicyWorkflowDataPrivate.TriggerEmailForBatchScripts"/>	
                    </xsltRequests>
                  </CustomServer.processRq>
				  <Request.ifRq condition="'~RenewStatus~' != 'success'">
                        <then>
                          <xsl:element name="OnlineData.addLogRq">
                            <xsl:attribute name="logType">
                              <xsl:text>PolicyRemainder:EmailorSMSIntegration Failure</xsl:text>
                            </xsl:attribute>
                            <xsl:attribute name="action">
                              <xsl:text>~policyID~:Error</xsl:text>
                            </xsl:attribute>
                            <xsl:element name="params">
                              <xsl:element name="param">
                                <xsl:attribute name="name">
                                  <xsl:text>policyID</xsl:text>
                                </xsl:attribute>
                                <xsl:attribute name="value">~policyID~</xsl:attribute>
                              </xsl:element>
                              <xsl:element name="param">
                                <xsl:attribute name="name">
                                  <xsl:text>ErrorIn</xsl:text>
                                </xsl:attribute>
                                <xsl:attribute name="value">~IntegrationErrorResponse~</xsl:attribute>
                              </xsl:element>
                            </xsl:element>
                          </xsl:element>
                        </then>
                  </Request.ifRq>
                </else>
              </Request.ifRq>
            </xsltRequests>
          </CustomServer.processRq>
        </requests>
      </Execute>
      <PostExecute>
        <requests />
      </PostExecute>
    </BatchProcess.processRq>
    <Session.closeRq />
  </requests>
</server>