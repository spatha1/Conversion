<?xml version="1.0" encoding="UTF-8" ?>
<settings>
	<CoreDirectory>Skins\DCTBase\Suite_Core</CoreDirectory>	
	<ThirdPartyDebug>.min</ThirdPartyDebug>
	<BaseDebug>-debug</BaseDebug>
	<Themes> 
		<Theme name="Capricorn-worker"/>
	</Themes>
	<Panels>
		<RatingMessages showBar="1" />
	</Panels>
	<Controls>
		<WorkbenchToolbar enabled="1" TasksDueDateSortOrder ="Ascending">
			<ToolbarGroups>
				<Group name="NotesController" enabled="1"/>
				<Group name="AttachmentsController" enabled="1"/>
				<Group name="TasksController" enabled="1"/>
			</ToolbarGroups>
		</WorkbenchToolbar>
		<ValidationHighlight SkipRequiredOnBlur="1" />
		<MultipleLanguages enabled="1" />
	</Controls>
	<custom></custom>
	<ErrorDisplayLocation location="inline"/>
	<ApiVersion>api/v2</ApiVersion>
	<ExpressDefaultPageApiEndpoint>/me/express/defaultViewmodel</ExpressDefaultPageApiEndpoint>	
	<ExpressXsltDirectory>/Skins/Suite/</ExpressXsltDirectory>	
	<StateFulFlag>1</StateFulFlag>
	<ExpressHandleClassicJump>2</ExpressHandleClassicJump>
	<HelpIcons>0</HelpIcons>
	<debugMode>1</debugMode>
	<AutoCompleteOff>false</AutoCompleteOff>
	<AutoCorrectOff>false</AutoCorrectOff>
	<AutoCapitalizeOff>false</AutoCapitalizeOff>
	<SpellCheckOff>false</SpellCheckOff>
	<TrackAllFields>0</TrackAllFields>
	<AnalyticsBag>0</AnalyticsBag>
	<UnauthorizedViewId>DuckCreekTech_PersonaError_VM_1_0_0_0_MainInterview_LoginFailed_View</UnauthorizedViewId>
	<LoadingDisplayDelayTime>5000</LoadingDisplayDelayTime>
	<InterstitialDisplayDelayTime>750</InterstitialDisplayDelayTime>
	<UseNativeControlsBelow>x-small</UseNativeControlsBelow>
	<RenderTitleForLabels>1</RenderTitleForLabels>
	<StatefulAttachments>0</StatefulAttachments>
	<FieldDebounceTime>750</FieldDebounceTime>
	<RatingMessageStyling>
		<PriorityOrder>alert,alert-alt1,warning,information,success,announcement</PriorityOrder>
		<MessageTypes>
			<Error>alert</Error>
			<Fail>alert</Fail>
			<Ineligible>alert-alt1</Ineligible>
			<Refer>warning</Refer>
			<Information>information</Information>
			<Success>success</Success>
			<Comment>announcement</Comment>
		</MessageTypes>
	</RatingMessageStyling>
	<IntegerDefaultFormatMask>??????????</IntegerDefaultFormatMask>
	<FloatDefaultFormatMask>???????????????.?????</FloatDefaultFormatMask>
	<PromptOnUnsavedChanges>0</PromptOnUnsavedChanges>
</settings>