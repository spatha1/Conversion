      <private id="Insights.CheckIfPolicyHasForms" caption="" type="string">
        <value>
          <if>
            <condition>
              <comparison compare="eq">
                <operand idref="data.HasForms" type="boolean" />
                <operand type="int" value="1" />
              </comparison>
            </condition>
            <then idref="Insights.SendPolicyPostForms" />
