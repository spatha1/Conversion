	<REL_KEY N_PRNT_CAT="8001" C_PRNT_KEY="BCS" N_CHLD_CAT="DCTPartyType" C_CHLD_KEY="B" />

Example 2: Remove the New Zealand country type mapping
	<REL_KEY N_PRNT_CAT="243" C_PRNT_KEY="7R" N_CHLD_CAT="DCTCountryType" C_CHLD_KEY="NZ" Delete="true" />
