<?xml version="1.0" encoding="UTF-8" ?>

<settings>
	<CoreDirectory>Skins\DCTBase\Core</CoreDirectory>
	<Themes>
		<Theme name="Worker"/> <!-- theme name is case-sensitive -->
		<ExtJsTheme cssFile="theme-gray-all"/>
		<DCTExtJsExtensionTheme cssFile="dctExt-xtheme"/>
	</Themes>
	<Panels>
		<RatingMessages showBar="1" />
		<TogglePanelButton showButton="0" />
	</Panels>
	<Buttons>
		<PreviousButtonDefaultType></PreviousButtonDefaultType>
		<NextButtonDefaultType></NextButtonDefaultType>
	</Buttons>
	<StaticPanelContent location="leftPanel"></StaticPanelContent>
	<Controls>
		<ComboBoxes maxSize="" />
		<WorkbenchToolbar enabled="1" TasksDueDateSortOrder="Ascending">
			<ToolbarGroups>
				<Group name="NotesController" enabled="1"/>
				<Group name="AttachmentsController" enabled="1"/>
				<Group name="TasksController" enabled="1"/>
				<Group name="LongProcessController" enabled="1"/>
			</ToolbarGroups>
		</WorkbenchToolbar>
		<ValidationHighlight SkipRequiredOnBlur="1" />
		<MultipleLanguages enabled="1" />
	</Controls>
	<custom></custom>
</settings>