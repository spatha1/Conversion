# ============================================================
# Policy Conversion — Environment Variables (EXAMPLE / TEMPLATE)
# Copy this to .env and fill in real values.
# ============================================================

# --- Pure Snowflake (Source) ---
SF_SOURCE_ACCOUNT=myorg-myaccount
SF_SOURCE_USER=conversion_user
SF_SOURCE_PASSWORD=s3cr3t
SF_SOURCE_WAREHOUSE=CONVERSION_WH
SF_SOURCE_DATABASE=RAW_DB
SF_SOURCE_SCHEMA=POLICY
SF_SOURCE_ROLE=CONVERSION_ROLE

# --- Staging Snowflake (same instance, landing zone) ---
SF_STAGING_ACCOUNT=myorg-myaccount
SF_STAGING_USER=conversion_user
SF_STAGING_PASSWORD=s3cr3t
SF_STAGING_WAREHOUSE=CONVERSION_WH
SF_STAGING_DATABASE=STAGING_DB
SF_STAGING_SCHEMA=POLICY_STAGING
SF_STAGING_ROLE=CONVERSION_ROLE

# --- SQL Server (Conversion DB / Middleware Config) ---
SQLSERVER_HOST=my-sqlserver.database.windows.net
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=ConversionDB
SQLSERVER_USER=conv_user
SQLSERVER_PASSWORD=s3cr3t
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# --- DuckCreek (DCT) API ---
DCT_BASE_URL=https://dct.example.com/api
DCT_API_KEY=abc123
DCT_ENVIRONMENT=UAT
DCT_TIMEOUT_SECONDS=60

# --- General ---
LOG_LEVEL=INFO
LOG_DIR=logs
